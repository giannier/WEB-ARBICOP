"size":"","sizes":[]},"flex_gap":{"column":"20","row":"20","isLinked":true,"unit":"px","size":20}},"elements":[{"id":"3cd11ba","elType":"widget","settings":{"image":{"id":292,"url":"http://localhost:8082/wp-content/uploads/2026/03/conciliacion.jpg","alt":"","source":"library","size":""},"image_size":"full"},"elements":[],"widgetType":"image"},{"id":"558c94b","elType":"widget","settings":{"title":"Promovemos una formación basada en valores como la ética, la neutralidad y la confidencialidad","header_size":"h3","__globals__":{"title_color":"globals/colors?id=accent"}},"elements":[],"widgetType":"heading"},{"id":"e1cdd3a","elType":"widget","settings":{"editor":"<p style=\"text-align: justify;\">La <strong data-start=\"125\" data-end=\"154\">Formación en Conciliación</strong> de <strong data-start=\"158\" data-end=\"192\">ARBICOP Instituto de Formación</strong> está orientada a preparar profesionales capaces de facilitar la resolución pacífica de conflictos mediante el diálogo, la negociación y la construcción de acuerdos entre las partes involucradas. En un contexto donde los conflictos son cada vez más frecuentes y complejos, la conciliación se posiciona como un mecanismo ágil, eficaz y altamente valorado.</p><p style=\"text-align: justify;\">Nuestro programa tiene como objetivo desarrollar competencias clave para intervenir como conciliador, promoviendo soluciones consensuadas que eviten procesos judiciales largos y costosos. A través de una formación integral, el participante adquiere herramientas para gestionar conflictos de manera estratégica, manteniendo siempre la imparcialidad y el respeto entre las partes.</p><p style=\"text-align: justify;\">Uno de los principales enfoques de nuestra formación es la aplicación práctica. Los participantes desarrollan sus habilidades mediante simulaciones de audiencias conciliatorias, análisis de casos reales y ejercicios guiados, lo que les permite adquirir experiencia en situaciones similares a las del ejercicio profesional.</p><p style=\"text-align: justify;\">Al finalizar el programa, el participante estará preparado para desempeñarse como conciliador en centros autorizados o aplicar estas habilidades en diversos ámbitos profesionales, contribuyendo a la solución efectiva de conflictos y al fortalecimiento de relaciones interpersonales y comerciales.</p>","text_color":"#5C5C5C","__globals__":{"text_color":""}},"elements":[],"widgetType":"text-editor"},{"id":"f283cac","elType":"widget","settings":{"title":"Competencias:","header_size":"h3","__globals__":{"title_color":"globals/colors?id=accent"}},"elements":[],"widgetType":"heading"},{"id":"125b900","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_gap":{"column":"30","row":"30","isLinked":true,"unit":"px","size":30}},"elements":[{"id":"710e7da","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"column":"30","row":"30","isLinked":true,"unit":"px","size":30}},"elements":[{"id":"8bccb05","elType":"widget","settings":{"image":{"id":249,"url":"http://localhost:8082/wp-content/uploads/2026/03/Check2.png","alt":"","source":"library","size":""},"title_text":"Gestión Efectiva de Conflictos","description_text":"Desarrolla la capacidad de intervenir y resolver conflictos mediante el diálogo y la negociación.","position":"left","image_space":{"unit":"px","size":20,"sizes":[]},"image_size":{"unit":"%","size":20,"sizes":[]},"image_size_tablet":{"unit":"%","size":15,"sizes":[]},"title_bottom_space":{"unit":"px","size":15,"sizes":[]},"__globals__":{"title_color":"globals/colors?id=primary","_background_color":"globals/colors?id=6985fc2"},"_padding":{"unit":"em","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"_padding_tablet":{"unit":"em","top":"","right":"","bottom":"","left":"","isLinked":true},"_padding_mobile":{"unit":"em","top":"","right":"","bottom":"","left":"","isLinked":true},"_background_background":"classic","_background_color_stop_tablet":{"unit"