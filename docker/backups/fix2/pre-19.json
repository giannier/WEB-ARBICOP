"","sizes":[]},"flex_gap":{"column":"20","row":"20","isLinked":true,"unit":"px","size":20}},"elements":[{"id":"4b16872","elType":"widget","settings":{"image":{"id":287,"url":"http://localhost:8082/wp-content/uploads/2026/03/arbitraje-1.jpg","alt":"","source":"library","size":""},"image_size":"full"},"elements":[],"widgetType":"image"},{"id":"d01e608","elType":"widget","settings":{"title":"Formamos especialistas capaces de intervenir en procesos arbitrales con criterio jurídico.","header_size":"h3","__globals__":{"title_color":"globals/colors?id=accent"}},"elements":[],"widgetType":"heading"},{"id":"b4fc4e6","elType":"widget","settings":{"editor":"<p style=\"text-align: justify;\">La <strong data-start=\"126\" data-end=\"152\">Formación en Arbitraje</strong> de <strong data-start=\"156\" data-end=\"190\">ARBICOP Instituto de Formación</strong> está diseñada para capacitar profesionales en uno de los mecanismos más eficientes y especializados para la resolución de conflictos: el arbitraje. Este sistema alternativo permite solucionar controversias de manera rápida, confidencial y técnica, convirtiéndose en una herramienta clave en el ámbito empresarial, contractual y legal.<br /><br />Nuestro programa tiene como objetivo formar especialistas capaces de intervenir en procesos arbitrales con criterio jurídico, capacidad analítica y enfoque estratégico. El participante desarrollará competencias necesarias para comprender y aplicar los principios del arbitraje, así como para gestionar controversias de forma efectiva y profesional.<br /><br />Uno de los pilares de nuestro programa es el enfoque práctico. A través de simulaciones de audiencias arbitrales, análisis de casos reales y ejercicios aplicados, los participantes adquieren experiencia en situaciones similares a las que enfrentarán en el ejercicio profesional. Esto les permite desarrollar habilidades de argumentación, negociación y resolución de controversias.<br /><br />Al culminar la formación, el egresado estará preparado para desempeñarse como árbitro, asesor o consultor en procesos arbitrales, tanto en el ámbito público como privado, contribuyendo a la solución eficiente de conflictos y fortaleciendo su perfil profesional en un campo altamente valorado.</p>","text_color":"#5C5C5C","__globals__":{"text_color":""}},"elements":[],"widgetType":"text-editor"},{"id":"d631801","elType":"widget","settings":{"title":"Competencias:","header_size":"h3","__globals__":{"title_color":"globals/colors?id=accent"}},"elements":[],"widgetType":"heading"},{"id":"e9388ed","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_gap":{"column":"30","row":"30","isLinked":true,"unit":"px","size":30}},"elements":[{"id":"eb84e82","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"column":"30","row":"30","isLinked":true,"unit":"px","size":30}},"elements":[{"id":"2fa0775","elType":"widget","settings":{"image":{"id":249,"url":"http://localhost:8082/wp-content/uploads/2026/03/Check2.png","alt":"","source":"library","size":""},"title_text":"Dominio del Proceso Arbitral","description_text":"Comprende cada etapa del arbitraje, desde el convenio arbitral hasta la emisión del laudo.","position":"left","image_space":{"unit":"px","size":20,"sizes":[]},"image_size":{"unit":"%","size":20,"sizes":[]},"image_size_tablet":{"unit":"%","size":15,"sizes":[]},"title_bottom_space":{"unit":"px","size":15,"sizes":[]},"__globals__":{"title_color":"globals/colors?id=primary","_background_color":"globals/colors?id=6985fc2"},"_padding":{"unit":"em","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"_padding_tablet":{"unit":"em","top":"","right":"","bottom":"","left":"","isLinked":true},"_padding_mobile":{"unit":"em","top":"","right":"","bottom":"","left":"","isLinked":true},"_background_background":"classic","_background_color_stop_tablet":{"unit":"%","size":"","sizes":[]},"_background_color_stop_mobile":{"unit":"%","size":"","sizes":[]},"_ba