e":"","sizes":[]},"flex_gap":{"column":"20","row":"20","isLinked":true,"unit":"px","size":20}},"elements":[{"id":"d8cc3d6","elType":"widget","settings":{"image":{"id":283,"url":"http://localhost:8082/wp-content/uploads/2026/03/peritaje-2.jpg","alt":"","source":"library","size":""},"image_size":"full"},"elements":[],"widgetType":"image"},{"id":"18cac971","elType":"widget","settings":{"title":"El Perito cumple un rol clave como auxiliar de la Justicia","header_size":"h3","__globals__":{"title_color":"globals/colors?id=accent"}},"elements":[],"widgetType":"heading"},{"id":"24f24ffc","elType":"widget","settings":{"editor":"<p style=\"text-align: justify;\">La <strong data-start=\"116\" data-end=\"141\">Formación en Peritaje</strong> de <strong data-start=\"145\" data-end=\"179\">ARBICOP Instituto de Formación</strong> está diseñada para preparar profesionales capaces de intervenir de manera técnica, objetiva y fundamentada en procesos judiciales, administrativos y privados, donde se requiera un análisis especializado.</p><p style=\"text-align: justify;\">A lo largo de la formación, los estudiantes adquieren conocimientos en metodología de investigación, análisis técnico, interpretación normativa y redacción de informes periciales. Además, se fortalecen habilidades para la sustentación oral, el manejo de evidencias y la actuación profesional con criterio ético e imparcial.</p><p style=\"text-align: justify;\" data-start=\"1039\" data-end=\"1321\">Nuestra metodología combina teoría y práctica, mediante el análisis de casos reales, ejercicios aplicados y simulaciones que permiten al participante enfrentarse a situaciones similares a las del ejercicio profesional. Esto garantiza una formación integral y orientada a resultados.</p><p style=\"text-align: justify;\" data-start=\"1323\" data-end=\"1568\">Al finalizar el programa, el egresado estará capacitado para desempeñarse como perito independiente o colaborar con instituciones públicas y privadas, brindando servicios de evaluación técnica con alto nivel de responsabilidad y profesionalismo.</p>","text_color":"#5C5C5C","__globals__":{"text_color":""}},"elements":[],"widgetType":"text-editor"},{"id":"43e5329","elType":"widget","settings":{"title":"Competencias:","header_size":"h3","__globals__":{"title_color":"globals/colors?id=accent"}},"elements":[],"widgetType":"heading"},{"id":"45ddcb96","elType":"container","settings":{"content_width":"full","flex_direction":"row","flex_gap":{"column":"30","row":"30","isLinked":true,"unit":"px","size":30}},"elements":[{"id":"6d9aac5e","elType":"container","settings":{"content_width":"full","flex_direction":"column","flex_gap":{"column":"30","row":"30","isLinked":true,"unit":"px","size":30}},"elements":[{"id":"3692bc7c","elType":"widget","settings":{"image":{"id":249,"url":"http://localhost:8082/wp-content/uploads/2026/03/Check2.png","alt":"","source":"library","size":""},"title_text":"Análisis Técnico Pericial","description_text":"Desarrolla la capacidad de evaluar hechos y evidencias con criterio técnico, base fundamental del trabajo pericial.","position":"left","image_space":{"unit":"px","size":20,"sizes":[]},"image_size":{"unit":"%","size":20,"sizes":[]},"image_size_tablet":{"unit":"%","size":15,"sizes":[]},"title_bottom_space":{"unit":"px","size":15,"sizes":[]},"__globals__":{"title_color":"globals/colors?id=primary","_background_color":"globals/colors?id=6985fc2"},"_padding":{"unit":"em","top":"1","right":"1","bottom":"1","left":"1","isLinked":true},"_padding_tablet":{"unit":"em","top":"","right":"","bottom":"","left":"","isLinked":true},"_padding_mobile":{"unit":"em","top":"","right":"","bottom":"","left":"","isLinked":true},"_background_background":"classic","_background_color_stop_tablet":{"unit":"%","size":"","sizes":[]},"_background_color_stop_mobile":{"unit":"%","size":"","sizes":[]},"_background_color_b_stop_tablet":{"unit":"%","size":"","sizes":[]},"_background_color_b_stop_mobile":{"unit":"%","size":"","sizes":[]},"_background_gradie